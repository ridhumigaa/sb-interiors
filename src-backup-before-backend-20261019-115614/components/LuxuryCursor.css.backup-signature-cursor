.luxury-cursor {
  position: fixed;
  top: 0;
  left: 0;
  width: 30px;
  height: 30px;
  border: 2px solid #f5c96b;
  border-radius: 50%;
  pointer-events: none;
  z-index: 99999;
  opacity: 0;
  box-shadow:
    0 0 8px rgba(245, 201, 107, 0.65),
    0 0 20px rgba(245, 201, 107, 0.28),
    inset 0 0 7px rgba(245, 201, 107, 0.15);
  transition:
    width 0.22s ease,
    height 0.22s ease,
    border-color 0.22s ease,
    background 0.22s ease,
    box-shadow 0.22s ease,
    opacity 0.2s ease;
  will-change: transform;
}
body:has(.luxury-cursor) .luxury-cursor {
  opacity: 1;
}
.luxury-cursor span {
  position: absolute;
  width: 6px;
  height: 6px;
  left: 50%;
  top: 50%;
  border-radius: 50%;
  background: #ffe5a3;
  box-shadow: 0 0 10px #f5c96b, 0 0 18px rgba(245, 201, 107, 0.9);
  transform: translate(-50%, -50%);
}
.luxury-cursor.is-hovering {
  width: 48px;
  height: 48px;
  border-color: #ffe7a8;
  background: rgba(245, 201, 107, 0.15);
  box-shadow:
    0 0 12px rgba(245, 201, 107, 0.85),
    0 0 30px rgba(245, 201, 107, 0.45),
    inset 0 0 12px rgba(245, 201, 107, 0.2);
}
@media (pointer: fine) {
  body:has(.luxury-cursor) {
    cursor: none;
  }
  body:has(.luxury-cursor) a,
  body:has(.luxury-cursor) button,
  body:has(.luxury-cursor) input,
  body:has(.luxury-cursor) textarea,
  body:has(.luxury-cursor) select {
    cursor: none;
  }
}
@media (pointer: coarse) {
  .luxury-cursor {
    display: none;
  }
}
